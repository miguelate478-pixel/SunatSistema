// Prisma Schema - Plataforma Control SUNAT
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  companyRoles      UserCompanyRole[]
  createdCompanies  Company[]         @relation("CompanyCreator")
  createdVouchers   Voucher[]         @relation("VoucherCreator")
  createdAlerts     Alert[]           @relation("AlertCreator")
  auditLogs         AuditLog[]

  @@index([email])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userCompanyRoles UserCompanyRole[]

  @@map("roles")
}

model UserCompanyRole {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  roleId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId, roleId])
  @@map("user_company_roles")
}

// ============================================================
// COMPANY & ENTITIES
// ============================================================

model Supplier {
  id            String   @id @default(uuid())
  companyId     String
  ruc           String
  razonSocial   String
  nombreComercial String?
  direccion     String?
  telefono      String?
  email         String?
  contacto      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers Voucher[] @relation("SupplierVouchers")

  @@unique([companyId, ruc])
  @@index([companyId])
  @@index([ruc])
  @@map("suppliers")
}

model Customer {
  id              String   @id @default(uuid())
  companyId       String
  ruc             String
  razonSocial     String
  nombreComercial String?
  direccion       String?
  telefono        String?
  email           String?
  contacto        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers Voucher[] @relation("CustomerVouchers")

  @@unique([companyId, ruc])
  @@index([companyId])
  @@index([ruc])
  @@map("customers")
}

model Company {
  id              String   @id @default(uuid())
  ruc             String   @unique
  razonSocial     String
  nombreComercial String?
  direccion       String?
  telefono        String?
  email           String?
  logo            String?
  sector          String
  plan            String   @default("PROFESSIONAL")
  isActive        Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  createdBy         User                @relation("CompanyCreator", fields: [createdById], references: [id])
  userRoles         UserCompanyRole[]
  suppliers         Supplier[]
  customers         Customer[]
  vouchers          Voucher[]
  alerts            Alert[]
  accountsReceivable AccountReceivable[]
  accountsPayable   AccountPayable[]
  reportExecutions  ReportExecution[]
  auditLogs         AuditLog[]
  sunatCredential   SunatCredential?
  syncExecutions    SyncExecution[]
  downloadJobs      DownloadJob[]

  @@index([ruc])
  @@index([createdById])
  @@map("companies")
}

// ============================================================
// VOUCHERS (COMPROBANTES)
// ============================================================

model Voucher {
  id                   String    @id @default(uuid())
  companyId            String
  downloadJobId        String?   // ← Referencia rápida al ÚLTIMO job
  tipo                 String
  serie                String
  numero               String
  fechaEmision         DateTime
  fechaVencimiento     DateTime?
  rucEmisor            String
  razonSocialEmisor    String
  rucReceptor          String
  razonSocialReceptor  String
  moneda               String    @default("PEN")
  subtotal             Decimal   @db.Decimal(12, 2)
  igv                  Decimal   @db.Decimal(12, 2)
  total                Decimal   @db.Decimal(12, 2)
  estado               String    @default("PENDIENTE")
  tieneXML             Boolean   @default(false)
  tienePDF             Boolean   @default(false)
  tieneCDR             Boolean   @default(false)
  afectoDetraccion     Boolean   @default(false)
  porcentajeDetraccion Decimal?  @db.Decimal(5, 2)
  montoDetraccion      Decimal?  @db.Decimal(12, 2)
  estadoDetraccion     String?
  direccion            String?
  observaciones        String?   @db.Text
  metadata             Json?
  supplierId           String?
  customerId           String?
  createdById          String?   // ← Nullable
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  // Relations
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lastDownloadJob    DownloadJob?          @relation("VoucherLastJob", fields: [downloadJobId], references: [id], onDelete: SetNull)
  supplier           Supplier?             @relation("SupplierVouchers", fields: [supplierId], references: [id])
  customer           Customer?             @relation("CustomerVouchers", fields: [customerId], references: [id])
  createdBy          User?                 @relation("VoucherCreator", fields: [createdById], references: [id])
  items              VoucherItem[]
  documents          VoucherDocument[]
  detraction         Detraction?
  accountReceivable  AccountReceivable?
  accountPayable     AccountPayable?
  downloadJobHistory DownloadJobVoucher[]  // ← Historial completo N:M

  @@unique([companyId, tipo, serie, numero])
  @@index([companyId])
  @@index([downloadJobId])
  @@index([serie, numero])
  @@index([fechaEmision])
  @@index([rucEmisor])
  @@index([rucReceptor])
  @@index([estado])
  @@index([direccion])
  @@index([supplierId])
  @@index([customerId])
  @@index([deletedAt])
  @@map("vouchers")
}

model VoucherItem {
  id             String  @id @default(uuid())
  voucherId      String
  descripcion    String  @db.Text
  cantidad       Decimal @db.Decimal(12, 4)
  unidad         String
  precioUnitario Decimal @db.Decimal(12, 4)
  subtotal       Decimal @db.Decimal(12, 2)
  igv            Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  orden          Int     @default(0)
  metadata       Json?

  // Relations
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@map("voucher_items")
}

model VoucherDocument {
  id           String   @id @default(uuid())
  voucherId    String
  downloadJobId String? // ← Referencia rápida al ÚLTIMO job
  tipo         String
  filename     String
  filepath     String
  filesize     Int
  mimeType     String
  storageUrl   String?
  uploadedAt   DateTime @default(now())
  metadata     Json?

  // Relations
  voucher            Voucher                 @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lastDownloadJob    DownloadJob?            @relation("DocumentLastJob", fields: [downloadJobId], references: [id], onDelete: SetNull)
  downloadJobHistory DownloadJobDocument[]   // ← Historial completo N:M

  @@unique([voucherId, tipo])  // ← Constraint única para upsert
  @@index([voucherId])
  @@index([downloadJobId])
  @@index([tipo])
  @@map("voucher_documents")
}

// ============================================================
// DETRACTIONS
// ============================================================

model Detraction {
  id                String    @id @default(uuid())
  voucherId         String    @unique
  porcentaje        Decimal   @db.Decimal(5, 2)
  monto             Decimal   @db.Decimal(12, 2)
  estado            String    @default("PENDIENTE")
  fechaPago         DateTime?
  numeroConstancia  String?
  observaciones     String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([estado])
  @@index([fechaPago])
  @@map("detractions")
}

// ============================================================
// ACCOUNTS RECEIVABLE & PAYABLE
// ============================================================

model AccountReceivable {
  id               String    @id @default(uuid())
  companyId        String
  voucherId        String    @unique
  customerId       String?
  cliente          String
  ruc              String
  documento        String
  monto            Decimal   @db.Decimal(12, 2)
  moneda           String    @default("PEN")
  fechaEmision     DateTime
  fechaVencimiento DateTime
  diasVencimiento  Int
  estado           String    @default("VIGENTE")
  montoPagado      Decimal   @default(0) @db.Decimal(12, 2)
  saldo            Decimal   @db.Decimal(12, 2)
  observaciones    String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([estado])
  @@index([fechaVencimiento])
  @@map("accounts_receivable")
}

model AccountPayable {
  id               String    @id @default(uuid())
  companyId        String
  voucherId        String    @unique
  supplierId       String?
  proveedor        String
  ruc              String
  documento        String
  monto            Decimal   @db.Decimal(12, 2)
  moneda           String    @default("PEN")
  fechaEmision     DateTime
  fechaVencimiento DateTime
  diasVencimiento  Int
  estado           String    @default("VIGENTE")
  montoPagado      Decimal   @default(0) @db.Decimal(12, 2)
  saldo            Decimal   @db.Decimal(12, 2)
  observaciones    String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([estado])
  @@index([fechaVencimiento])
  @@map("accounts_payable")
}

// ============================================================
// ALERTS
// ============================================================

model Alert {
  id          String    @id @default(uuid())
  companyId   String
  tipo        String
  categoria   String
  titulo      String
  descripcion String    @db.Text
  accion      String?
  leida       Boolean   @default(false)
  metadata    Json?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("AlertCreator", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([tipo])
  @@index([categoria])
  @@index([leida])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("alerts")
}

// ============================================================
// REPORTS
// ============================================================

model ReportExecution {
  id          String   @id @default(uuid())
  companyId   String
  tipo        String
  formato     String
  parametros  Json
  estado      String   @default("PENDING")
  filepath    String?
  filesize    Int?
  storageUrl  String?
  errorMsg    String?  @db.Text
  executedAt  DateTime @default(now())
  completedAt DateTime?

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([tipo])
  @@index([estado])
  @@index([executedAt])
  @@map("report_executions")
}

// ============================================================
// SUNAT CREDENTIALS (per company)
// ============================================================

model SunatCredential {
  id                  String    @id @default(uuid())
  companyId           String    @unique
  ruc                 String
  clientId            String
  clientSecret        String    @db.Text
  usuario             String    @default("")
  claveSol            String    @default("") @db.Text
  isActive            Boolean   @default(true)
  lastTestedAt        DateTime?
  lastTestOk          Boolean?
  lastTestMessage     String?
  lastSyncAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("sunat_credentials")
}

// ============================================================
// DOWNLOAD JOBS (SUNAT)
// ============================================================

model DownloadJob {
  id            String    @id @default(uuid())
  companyId     String
  numTicket     String
  tipo          String
  periodo       String
  status        String    @default("PENDING")
  progress      Int       @default(0)
  errorMessage  String?   @db.Text
  resultData    Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  // Relations
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchersLastJob      Voucher[]             @relation("VoucherLastJob")      // ← Vouchers que tienen este job como último
  documentsLastJob     VoucherDocument[]     @relation("DocumentLastJob")     // ← Documentos que tienen este job como último
  voucherHistory       DownloadJobVoucher[]  // ← Historial completo N:M
  documentHistory      DownloadJobDocument[] // ← Historial completo N:M

  @@index([companyId])
  @@index([status])
  @@index([numTicket])
  @@index([createdAt])
  @@map("download_jobs")
}

// ============================================================
// SYNC EXECUTIONS
// ============================================================

model SyncExecution {
  id           String    @id @default(uuid())
  companyId    String
  tipo         String    @default("DIARIA")
  estado       String    @default("PENDING")
  periodo      String?
  fechaInicio  String?
  fechaFin     String?
  docsNuevos   Int       @default(0)
  docsOk       Int       @default(0)
  docsError    Int       @default(0)
  errorMsg     String?   @db.Text
  duracionMs   Int?
  triggeredBy  String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([estado])
  @@index([tipo])
  @@index([startedAt])
  @@map("sync_executions")
}

// ============================================================
// DOWNLOAD JOB BRIDGE TABLES (Auditoría e Historial)
// ============================================================

model DownloadJobVoucher {
  id            String      @id @default(uuid())
  downloadJobId String
  voucherId     String
  wasNew        Boolean     @default(false)  // ¿Era nuevo o ya existía?
  dataChanged   Boolean     @default(false)  // ¿Cambió algún dato entre descargas?
  createdAt     DateTime    @default(now())

  // Relations
  downloadJob DownloadJob @relation(fields: [downloadJobId], references: [id], onDelete: Cascade)
  voucher     Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([downloadJobId, voucherId])  // Un voucher solo una vez por job
  @@index([downloadJobId])
  @@index([voucherId])
  @@index([createdAt])
  @@index([wasNew])
  @@map("download_job_vouchers")
}

model DownloadJobDocument {
  id                String          @id @default(uuid())
  downloadJobId     String
  voucherDocumentId String
  createdAt         DateTime        @default(now())

  // Relations
  downloadJob     DownloadJob     @relation(fields: [downloadJobId], references: [id], onDelete: Cascade)
  voucherDocument VoucherDocument @relation(fields: [voucherDocumentId], references: [id], onDelete: Cascade)

  @@unique([downloadJobId, voucherDocumentId])
  @@index([downloadJobId])
  @@index([voucherDocumentId])
  @@map("download_job_documents")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  userId     String
  action     String
  entity     String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}